rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    match /atividades/{id} {

      // Somente o Afonso pode visualizar as atividades
      allow read: if request.auth != null
        && request.auth.uid == "lzfE7smV0dW38VccI41dKCde2Kc2";

      // Criar atividade
      allow create: if request.auth != null
        && request.auth.uid == "lzfE7smV0dW38VccI41dKCde2Kc2"
        && request.resource.data.criadaPor == request.auth.uid
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() >= 3
        && request.resource.data.concluida == false
        && request.resource.data.concluidaPor == null
        && request.resource.data.concluidaPorNome == null
        && request.resource.data.concluidaEm == null;

      // Atualizar atividade
      allow update: if request.auth != null
        && request.auth.uid == "lzfE7smV0dW38VccI41dKCde2Kc2"

        // O criador original nunca pode ser alterado
        && request.resource.data.criadaPor == resource.data.criadaPor

        // Atividade concluída nunca pode ser reaberta
        && !(resource.data.concluida == true
          && request.resource.data.concluida == false)

        // Se já estava concluída, quem concluiu não pode ser alterado
        && !(resource.data.concluida == true
          && request.resource.data.concluidaPor != resource.data.concluidaPor)

        // Se já estava concluída, o nome não pode ser alterado
        && !(resource.data.concluida == true
          && request.resource.data.concluidaPorNome != resource.data.concluidaPorNome)

        // Se já estava concluída, a data não pode ser alterada
        && !(resource.data.concluida == true
          && request.resource.data.concluidaEm != resource.data.concluidaEm)

        // Enquanto estiver pendente, os dados de conclusão permanecem vazios
        && (
          request.resource.data.concluida == true
          || (
            request.resource.data.concluida == false
            && request.resource.data.concluidaPor == null
            && request.resource.data.concluidaPorNome == null
            && request.resource.data.concluidaEm == null
          )
        )

        // Ao concluir, a conclusão deve pertencer ao usuário autenticado
        && (
          resource.data.concluida == true
          || request.resource.data.concluida == false
          || (
            request.resource.data.concluida == true
            && request.resource.data.concluidaPor == request.auth.uid
            && request.resource.data.concluidaPorNome is string
            && request.resource.data.concluidaEm != null
          )
        );

      // Somente o Afonso pode excluir atividades
      allow delete: if request.auth != null
        && request.auth.uid == "lzfE7smV0dW38VccI41dKCde2Kc2";

    }

    // Qualquer outra coleção/documento fica bloqueada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
