# Firebase — Afonso Contábeis
# Preencha com os dados do NOVO projeto em https://console.firebase.google.com
# Project Settings > General > Your apps > SDK setup and configuration > Config
#
# Copie este arquivo para ".env" (que fica no .gitignore) e preencha os valores.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opcional (se usar measurementId):
# VITE_FIREBASE_MEASUREMENT_ID=
